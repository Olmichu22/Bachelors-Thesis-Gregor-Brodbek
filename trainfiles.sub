# Make train files sub
executable = make_train_files.sh
Arguments = $(OUTPUTDIR) $(INPUTDIR) $(FILEID)

Log = $(OUTPUTDIR)/logs/Tree_$(FILEID).log
Output = $(OUTPUTDIR)/out/Tree_$(FILEID).out
Error = $(OUTPUTDIR)/err/Tree_$(FILEID).err

should_transfer_files = Yes
when_to_transfer_output = ON_EXIT

Queue OUTPUTDIR, INPUTDIR, FILEID from input_ids.txt
